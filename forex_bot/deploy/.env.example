# forex_bot — environment template
# Copy to .env (or paste into deploy/run_bot.cmd / EnvironmentFile) and chmod 600.
# Nothing here belongs in git.

# ── which account the bot is allowed to trade (mismatch = refuse to start)
FXBOT_MT5_LOGIN=12345678
FXBOT_MT5_SERVER=Broker-Demo
# FXBOT_MT5_PASSWORD=            # leave unset to reuse the already-logged-in terminal
# FXBOT_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ── remote control
FXBOT_TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FXBOT_TELEGRAM_CHAT_IDS=734112288
# FXBOT_TELEGRAM_PAIR=            # one-time /pair code; random per boot if unset

# ── risk + strategy knobs (override config.py)
FXBOT_MAX_RISK_PER_TRADE=0.01
FXBOT_MAX_DAILY_LOSS=0.05
FXBOT_MAX_DRAWDOWN_LIMIT=0.15
FXBOT_MIN_CONFIDENCE=0.6
FXBOT_LOT_SIZE=0.01

# ── infra
FXBOT_LOG_LEVEL=INFO
FXBOT_TICK_INTERVAL=60
